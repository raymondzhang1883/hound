#!/bin/sh
set -eu
HOUND_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd -- "$HOUND_ROOT"
case "${1:-}" in
  hunt)
    shift
    export PLAYWRIGHT_BROWSERS_PATH="$HOUND_ROOT/.hound/browsers"
    if [ "${1:-}" = "--local" ]; then
      shift
      exec node --env-file-if-exists="$HOUND_ROOT/.env" --import tsx "$HOUND_ROOT/services/runtime/scripts/hunt.ts" "$@"
    fi
    exec node --env-file-if-exists="$HOUND_ROOT/.env" --import tsx "$HOUND_ROOT/services/runtime/scripts/control.ts" hunt "$@"
    ;;
  worker)
    shift
    export PLAYWRIGHT_BROWSERS_PATH="$HOUND_ROOT/.hound/browsers"
    exec node --env-file-if-exists="$HOUND_ROOT/.env" --import tsx "$HOUND_ROOT/services/runtime/scripts/worker.ts" "$@"
    ;;
  control)
    shift
    exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/control-stack.ts" "$@"
    ;;
  status|logs|cancel)
    exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/control.ts" "$@"
    ;;
  runs)
    shift
    if [ "${1:-}" = "--local" ]; then
      shift
      exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/hound.ts" runs "$@"
    fi
    exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/control.ts" runs "$@"
    ;;
  show|report)
    HOUND_COMMAND=$1
    shift
    if [ "${1:-}" = "--local" ]; then
      shift
      exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/hound.ts" "$HOUND_COMMAND" "$@"
    fi
    exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/control.ts" "$HOUND_COMMAND" "$@"
    ;;
  minimize)
    shift
    export PLAYWRIGHT_BROWSERS_PATH="$HOUND_ROOT/.hound/browsers"
    if [ "${1:-}" = "--local" ]; then
      shift
      exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/minimize.ts" --local "$@"
    fi
    exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/minimize.ts" "$@"
    ;;
esac
exec node --import tsx "$HOUND_ROOT/services/runtime/scripts/hound.ts" "$@"
