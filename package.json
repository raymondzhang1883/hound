{
  "name": "hound",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "hound": "./hound"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test apps/fixture/tests/*.test.ts services/runtime/tests/*.test.ts",
    "setup:browser": "PLAYWRIGHT_BROWSERS_PATH=.hound/browsers playwright install chromium",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.hound/browsers playwright test",
    "test:runtime": "PLAYWRIGHT_BROWSERS_PATH=.hound/browsers playwright test services/runtime/tests/browser",
    "test:control": "node services/control-plane/tests/lifecycle.mjs",
    "hunt": "./hound hunt",
    "worker": "./hound worker",
    "hunt:check": "PLAYWRIGHT_BROWSERS_PATH=.hound/browsers playwright test services/runtime/tests/browser/hunt.spec.ts",
    "hound": "./hound",
    "minimize": "PLAYWRIGHT_BROWSERS_PATH=.hound/browsers node --import tsx services/runtime/scripts/minimize.ts",
    "test:generated": "PLAYWRIGHT_BROWSERS_PATH=.hound/browsers playwright test generated-tests",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "fixture": "tsx apps/fixture/src/main.ts",
    "demo": "tsx apps/fixture/scripts/demo.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
